		"autoprefixer": "^10.4.20",
		"bits-ui": "0.22.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.0.4",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.10",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^0.3.28",
		"tailwind-merge": "^3.2.0",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.0.0",
