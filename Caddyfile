# Replace your-domain.com with your actual domain
your-domain.com {
    # Enable gzip and zstd compression
    encode gzip zstd

    # Proxy requests to the SvelteKit app running in Docker on port 3000
    # Caddy assumes localhost if no host is specified
    reverse_proxy localhost:3000

    # Optional: Add headers for security, logging, etc.
    header {
      Strict-Transport-Security "max-age=31536000;"
      X-Content-Type-Options "nosniff"
      X-Frame-Options "DENY"
      Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Optional: Customize logging
    # log {
    #   output file /var/log/caddy/access.log
    #   format json
    # }
}

# Optional: Redirect www to non-www (or vice-versa)
# www.your-domain.com {
#   redir https://your-domain.com{uri} permanent
# }