# .env.example
# Copy this file to .env and replace the placeholder values with your actual credentials.
# These are used by the application, especially when running locally or if you need
# to override Docker defaults.

# Required by src/routes/api/chat/+server.ts
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY_HERE"

# Optional: The port the server will listen on. Defaults to 3000 if not set.
# The Dockerfile also sets this, but it can be overridden at runtime.
# PORT=3000 